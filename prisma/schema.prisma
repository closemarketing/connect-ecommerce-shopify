// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Shop {
  id        Int      @id @default(autoincrement())
  domain    String   @unique // integra-clientify.myshopify.com
  active    Boolean  @default(true) // Si la app está instalada y activa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  orders            Order[]
  syncLogs          SyncLog[]
  webhookLogs       WebhookLog[]
  erpWebhookConfigs ERPWebhookConfig[]
  shopIntegrations  ShopIntegration[]
  holdedSyncJobs    HoldedSyncJob[]
  odooSyncJobs      OdooSyncJob[]
}

model Session {
  id                  String    @id
  shop                String // Dominio de la tienda (requerido por Shopify)
  shopId              Int? // FK opcional a Shop
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  shopRecord Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([shop, isOnline]) // Solo una sesión offline por tienda
  @@index([shop])
  @@index([shopId])
}

model Integration {
  id               Int                     @id @default(autoincrement())
  name             String                  @unique
  displayName      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  credentials      IntegrationCredential[]
  shopIntegrations ShopIntegration[]
  syncLogs         SyncLog[]
  webhookLogs      WebhookLog[]
}

// Tracks which integrations are enabled per shop
model ShopIntegration {
  id            Int         @id @default(autoincrement())
  shopId        Int
  integrationId Int
  active        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([shopId, integrationId])
  @@index([shopId])
  @@index([integrationId])
}

model IntegrationCredential {
  id            Int         @id @default(autoincrement())
  sessionId     String // Identificador de la tienda (shop)
  integrationId Int
  key           String // Nombre de la credencial (ej: "apikey", "url")
  value         String // Valor de la credencial
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, integrationId, key])
  @@index([sessionId])
}

model Order {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique // ID del pedido de Shopify
  orderNumber String // Número de pedido visible
  shopId      Int // FK a Shop
  body        String   @db.LongText // JSON completo del webhook
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([orderId])
}

model SyncLog {
  id            Int            @id @default(autoincrement())
  shopId        Int // FK a Shop
  syncType      SyncType // Tipo de objeto sincronizado
  shopifyId     String // ID del objeto en Shopify
  externalId    String? // ID resultante en el ERP externo (null si error)
  parentOrderId String? // ID de la orden padre si esta sync pertenece a una orden
  status        SyncStatus // Estado de la sincronización
  direction     SyncDirection  @default(SHOPIFY_TO_ERP)
  erpName       String?        // Nombre del ERP (clientify, holded, ...)
  integrationId Int?           // FK a Integration
  method        String? // Método HTTP: GET, POST, PUT, DELETE, etc
  url           String?        @db.Text // URL completa de la llamada a la API
  queryParams   String?        @db.Text // JSON de parámetros query si aplica
  errorMessage  String?        @db.Text // Mensaje de error si aplica
  requestData   String?        @db.LongText // JSON del request (opcional)
  responseData  String?        @db.LongText // JSON del response (opcional)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([syncType])
  @@index([status])
  @@index([erpName])
  @@index([integrationId])
  @@index([createdAt])
  @@index([parentOrderId])
}

enum SyncType {
  CUSTOMER
  PRODUCT
  DEAL
  ORDER
  PIPELINE
  STAGE
  HOLDED_PRODUCT
}

enum SyncStatus {
  SUCCESS
  ERROR
}

enum SyncDirection {
  SHOPIFY_TO_ERP
  ERP_TO_SHOPIFY
}

model WebhookLog {
  id            Int      @id @default(autoincrement())
  shopId        Int // FK a Shop
  integrationId Int?     // FK a Integration (null = webhook de Shopify genérico)
  topic         String // Ej: "orders/create", "orders/updated"
  shopifyId     String? // ID del objeto en Shopify (extraído del payload)
  headers       String   @db.Text // JSON de headers relevantes
  payload       String   @db.LongText // JSON completo del webhook
  hmacValid     Boolean? // Si se validó el HMAC
  processed     Boolean  @default(false) // Si se procesó exitosamente
  errorMessage  String?  @db.Text // Error si hubo al procesar
  createdAt     DateTime @default(now())

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([integrationId])
  @@index([topic])
  @@index([createdAt])
  @@index([processed])
}

model PipelineConfig {
  id                    Int      @id @default(autoincrement())
  shopId                Int // FK a Shop
  externalPipelineId   String // ID del pipeline en el ERP externo
  externalPipelineName String // Nombre del pipeline
  integrationId        Int // FK a Integration
  isDefault            Boolean  @default(false) // Si es el pipeline por defecto
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stageMappings OrderStageMapping[]

  @@unique([shopId, integrationId, externalPipelineId])
  @@index([shopId])
  @@index([integrationId])
}

model OrderStageMapping {
  id                 Int      @id @default(autoincrement())
  pipelineConfigId   Int // FK a PipelineConfig
  shopifyOrderStatus String // Estado de Shopify: pending, authorized, partially_paid, paid, partially_refunded, refunded, voided
  externalStageId   String // ID del stage en el ERP externo
  externalStageName String // Nombre del stage
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pipelineConfig PipelineConfig @relation(fields: [pipelineConfigId], references: [id], onDelete: Cascade)

  @@unique([pipelineConfigId, shopifyOrderStatus])
  @@index([pipelineConfigId])
}

enum HoldedSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model HoldedSyncJob {
  id             Int              @id @default(autoincrement())
  shopId         Int
  status         HoldedSyncStatus @default(PENDING)
  totalProducts  Int?
  syncedProducts Int              @default(0)
  errorCount     Int              @default(0)
  log            String?          @db.LongText
  summary        String?          @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}

enum OdooSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model OdooSyncJob {
  id             Int            @id @default(autoincrement())
  shopId         Int
  status         OdooSyncStatus @default(PENDING)
  totalProducts  Int?
  syncedProducts Int            @default(0)
  errorCount     Int            @default(0)
  log            String?        @db.LongText
  summary        String?        @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}

// Admin panel user (internal use only — not Shopify merchants)
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ERP webhook configuration per shop (bidirectional sync)
model ERPWebhookConfig {
  id            Int       @id @default(autoincrement())
  shopId        Int
  erpName       String // "clientify", "holded", ...
  webhookSecret String? // HMAC secret for validating inbound ERP webhooks
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, erpName])
  @@index([shopId])
}
